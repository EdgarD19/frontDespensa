# Target del proxy de Vite para desarrollo local (sin VITE_API_URL).
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8081

# ─────────────────────────────────────────────────────────────────────────────
# MODO NGROK (backend expuesto a internet) — usar SOLO cuando el duo comparta
# su túnel. Comentá esta línea cuando NO se use ngrok, para volver al proxy local.
#
#   VITE_API_URL=https://abc123.ngrok-free.app/DespensaProyect
#
# Efecto: el navegador (aunque estés en localhost:5173) pega directo a la URL
# pública de ngrok. Requiere CORS habilitado en el backend (WebConfig.java).
# ─────────────────────────────────────────────────────────────────────────────
