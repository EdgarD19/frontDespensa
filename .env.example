# Proxy de Vite → Spring (solo desarrollo). Si ECONNREFUSED, arrancá el backend o cambiá puerto.
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8081
#
# En `npm run dev` el cliente ignora VITE_API_BASE_URL y usa el proxy (evita CORS).
# Para `vite build` / preview sin proxy, descomentá y ajustá (incluí context-path si aplica):
# VITE_API_BASE_URL=http://localhost:8081/DespensaProyect

# Opcional: sobrescribir categorías/unidades/proveedores si los IDs no coinciden con init.sql
# VITE_MAESTROS_JSON={"categorias":[{"id":1,"nombre":"Comestibles"}],"unidades":[{"id":1,"nombre":"Gramos","abreviatura":"gr"}],"proveedores":[{"id":1,"nombre":"Conti"}]}
